# Copy this file to .env and fill in your values
# NEVER commit .env to GitHub

# Database (Railway provides this automatically)
DATABASE_URL=postgresql://username:password@host:5432/dbname

# Auth
JWT_SECRET=replace_with_a_long_random_string_at_least_32_chars

# Transcription
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# AI Structuring (Anthropic - console.anthropic.com)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-haiku-4-5

# App
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Optional: seed the 15 expert-solved cases and their approved frameworks on startup.
# Only enable once you have confirmed you may show these prompts and frameworks to students.
# SEED_EXPERT_CASES=true

# Judge (the "coach" that scores MECE and Relevant and writes the feedback after each drill).
# All optional; the defaults are shown.
# JUDGE_MODEL=claude-haiku-4-5       # defaults to ANTHROPIC_MODEL
# JUDGE_PROMPT_CACHE=false           # true caches the stable prompt. Turn on only if GET /api/admin/judge-stats shows a
#                                    # cache read share above roughly 22% (a cold cache write costs 1.25x, a read 0.1x)
# JUDGE_CACHE_TTL=5m                 # 5m or 1h
# JUDGE_RATE_PER_HOUR=30             # judged reviews per user per hour
# JUDGE_MAX_EXEMPLARS=40             # expert frameworks included in the prompt
# JUDGE_USE_DRAFT_PLAYBOOK=false     # force-include the per-shape playbook even if its file is not marked reviewed (it is, so this is normally unnecessary)
# EXPERT_DISPLAY_NAME=Expert consultant   # name students see on the seeded expert frameworks
